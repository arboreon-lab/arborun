    "用户提供 data/raw 下约 2.5 万张照片",
    "只有一台带 24GB 显存显卡的电脑",
    "训练总时长不超过 1 天"
  ],
  "clarifications": [
    {
      "question": "准确率要达到多少才算好？",
      "answer": "没见过的照片上至少 95%"
    },
    {
      "question": "最后怎么试用？",
      "answer": "本地网页，拖一张照片进去就显示猫还是狗"
    }
  ],
  "agents": [
    {
      "id": "main",
      "name": "主 Agent",
      "role": "拆分阶段、安排测试、汇总证据",
      "scope": "计划与验收记录",
      "budget": "不直接改代码"
    },
    {
      "id": "data",
      "name": "数据 Agent",
      "role": "整理和检查照片",
      "scope": "data/ 目录与数据脚本",
      "budget": "不删除原始照片",
      "parentId": "main"
    },
    {
      "id": "train",
      "name": "训练 Agent",
      "role": "写训练代码、训练和调参",
      "scope": "train/ 目录与显卡",
      "budget": "训练总时长不超过 20 小时",
      "parentId": "main"

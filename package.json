{
  "name": "arborun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tree-native workspace for human and agent execution",
  "main": "dist-desktop/main.cjs",
  "author": "Arboreon Lab",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build": "tsc --noEmit && vite build && pnpm build:desktop",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:mac": "pnpm build && electron-builder --mac dir --publish never",
    "package:win": "pnpm build && electron-builder --win nsis --publish never",
    "package:linux": "pnpm build && electron-builder --linux deb --publish never",
    "build:mcp": "node scripts/build-mcp.mjs",
    "start:mcp": "node dist-mcp/index.mjs",
    "test:mcp": "vitest run tests/mcp-*.test.ts",
    "test:mcp-ui": "playwright test tests/mcp-ui.e2e.ts",
    "preview:mcp": "pnpm build:mcp && node scripts/preview-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "roughjs": "4.6.6",
    "sql.js": "^1.14.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.2.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "lab.arboreon.arborun",
    "productName": "Arborun",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "deb",
      "category": "Development",
      "icon": "resources/icon.png"
    }
  }
}

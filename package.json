{
  "name": "arborun", "version": "0.1.0", "private": true, "type": "module",
  "description": "A tree-native workspace for human and agent execution",
  "main": "dist-desktop/main.cjs", "author": "Arboreon Lab",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build": "tsc --noEmit && vite build && pnpm build:desktop",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:mac": "pnpm build && electron-builder --mac dir --publish never",
    "package:win": "pnpm build && electron-builder --win nsis --publish never",
    "package:linux": "pnpm build && electron-builder --linux deb --publish never"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.577.0", "sql.js": "^1.14.1", "zod": "^4.3.6" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/sql.js": "^1.4.9", "@vitejs/plugin-react": "^6.0.0", "vite": "^8.3.5", "typescript": "^5.9.3", "electron": "45.2.2", "electron-builder": "^26.8.1", "esbuild": "^0.27.4", "vitest": "^4.1.0", "@playwright/test": "^1.58.2" },
  "pnpm": { "onlyBuiltDependencies": ["electron", "esbuild"] },
  "build": {
    "appId": "lab.arboreon.arborun", "productName": "Arborun",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-desktop/**/*", "package.json"],
    "extraResources": [{ "from": "node_modules/sql.js/dist/sql-wasm.wasm", "to": "sql-wasm.wasm" }],
    "mac": { "category": "public.app-category.productivity", "identity": null, "icon": "resources/icon.icns" },
    "win": { "target": "nsis", "icon": "resources/icon.png" }, "linux": { "target": "deb", "category": "Development", "icon": "resources/icon.png" }
  }
}
